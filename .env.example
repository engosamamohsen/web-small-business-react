# Copy this file to .env and fill in the values for your environment.
# .env is intentionally NOT committed to git — each server keeps its own copy.

# SSR / Astro build-time fallback.
# Must point to the admin API origin so server-side fetches resolve correctly.
# Production value: https://admin-{subdomain}.cashierthru.com
# Example:         https://admin-asly.cashierthru.com
PUBLIC_BASE_URL=https://admin-asly.cashierthru.com

# Default API origin while developing (npm run dev).
# localhost has no tenant subdomain, so API calls fall back to this test tenant.
# No effect on production builds (gated by import.meta.env.DEV).
PUBLIC_DEV_API_ORIGIN=https://admin-asly.cashierthru.com

# API path prefix appended to the origin in fetch-hook.ts.
PUBLIC_LAST_ROUTE_API_URL=/api/
