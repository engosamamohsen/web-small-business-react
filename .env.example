# Copy this file to .env and fill in the values for your environment.
# .env is intentionally NOT committed to git — each server keeps its own copy.

# ⚠️ MUST be the ADMIN API origin, NOT the shop URL.
# Server-side rendering fetches data from `PUBLIC_BASE_URL + /api/` directly
# (see src/hooks/fetch-hook.ts → getBaseUrl), so this has to point at the
# admin backend that actually serves /api/.
#   CORRECT:   https://admin-asly.cashierthru.com
#   WRONG:     https://asly.cashierthru.com   (the shop frontend has no /api/)
#
# Note: the browser (client-side) ignores this and derives admin-<tenant>
# automatically from window.location, so per-tenant client calls always work.
# This value only sets the single tenant used for server-side rendering.
PUBLIC_BASE_URL=https://admin-asly.cashierthru.com

# Default API origin while developing (npm run dev).
# localhost has no tenant subdomain, so API calls fall back to this test tenant.
# No effect on production builds (gated by import.meta.env.DEV).
PUBLIC_DEV_API_ORIGIN=https://admin-asly.cashierthru.com

# API path prefix appended to the origin in fetch-hook.ts.
PUBLIC_LAST_ROUTE_API_URL=/api/
