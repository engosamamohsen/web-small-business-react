# ── Multi-tenant SaaS configuration ─────────────────────────────────────────
#
# In production these values are NEVER used for API calls.
# The frontend reads window.location.origin at runtime so the same built bundle
# works on every tenant subdomain (shop1.cashierthru.com, myrestaurant.cashierthru.com…)
#
# PUBLIC_BASE_URL is only used as an SSR / build-time fallback in src/lib/config.ts
# when window is unavailable (Astro static generation).
# ─────────────────────────────────────────────────────────────────────────────

# SSR / Astro build-time fallback ONLY.
# This value is NEVER used in the browser — window.location.origin always drives API URLs.
# Only matters when Astro renders pages server-side (typeof window === "undefined").
PUBLIC_BASE_URL=http://localhost:3000

# Default API origin while developing (`npm run dev`).
# localhost has no tenant subdomain, so API calls fall back to this test tenant.
# Has NO effect on production builds (gated by import.meta.env.DEV in src/lib/config.ts).
PUBLIC_DEV_API_ORIGIN=https://admin-asly.cashierthru.com

# API path prefix appended to the origin in fetch-hook.ts
PUBLIC_LAST_ROUTE_API_URL=/api/
