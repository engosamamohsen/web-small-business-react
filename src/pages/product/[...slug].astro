---
import Layout from "@/layouts/Layout.astro";
import DetailPage from "@/components/products/DetailPage";
import Header from "@/layouts/Header/Header";
import Footer from "@/layouts/Footer";
import ColorHandler from "@/layouts/ColorHandler";
import LoginHandler from "@/layouts/LoginHandler";
import { ToastContainer } from "react-toastify";
import FaviconHandler from "@/layouts/FaviconHandler";
import { SettingsProvider } from "@/providers";
import { fetchSettings } from "@/hooks/fetchSettings";
import { buildWhatsAppLink, resolveWhatsappNumber } from "@/lib/whatsapp-order";
import { lookupProduct } from "@/lib/product-lookup";
import { schemaOfferPrice } from "@/lib/price-display";
import { buildProductPath, parseProductPath } from "@/lib/product-url";
import { getSiteOrigin } from "@/lib/site-origin";
import { buildStoreOrganization, storeOrganizationId } from "@/lib/seo";
import packageJson from "../../../package.json";
import type { ProductType } from "@/lib/types";

// SEO-friendly URL: /product/{id}/{name}  (e.g. /product/8/فتة-شاورما-فراخ), src/lib/product-url.ts.
// Older single-segment addresses (/product/ft-shaorma-frakh-8-…, /product/8) still resolve and
// 301 to it below.
const { slug: rawParam } = Astro.params as { slug?: string };

const parsed = parseProductPath(rawParam);

// Not a product address at all: answer 404 here (never a redirect, which search engines treat as "moved")
if (!parsed) {
    return Astro.rewrite("/404");
}

const { id } = parsed;

// Get auth token from cookies
const token = Astro.cookies.get("app_token")?.value;

// Per-request admin API base URL set by middleware (tenant-aware).
const apiBase = Astro.locals.apiBase;

// Fetch settings for the page
const settingsResponse = await fetchSettings(token, false, apiBase);

// Extract data with defaults
const settingsData = settingsResponse?.data ?? null;
const isLogin = settingsResponse?.ok
    ? Boolean(settingsResponse?.is_login)
    : false;
const cartCount = settingsResponse?.cart_count ?? 0;
const appVersion = (packageJson as any).version;

// WhatsApp contact link — null for missing/placeholder numbers (shared helper).
const whatsappLink = buildWhatsAppLink(resolveWhatsappNumber(settingsData));

// Fetch product details — same API contract as before, id-only (src/lib/product-lookup.ts).
// Missing product: 404 at this address. API down or slow (after one more try): 503 "try again",
// so a real product is never reported as gone.
const lookup = await lookupProduct(id, apiBase);
if (lookup.kind === "missing") {
    return Astro.rewrite("/404");
}
if (lookup.kind === "unavailable") {
    return Astro.rewrite("/unavailable");
}
const productData: ProductType = lookup.product;

// Canonical URL handling: any other address of this product (an older format,
// an old name) 301-redirects to the canonical /product/{id}/{name}.
const canonicalPath = buildProductPath(productData);
// The canonical path can contain non-ASCII (Arabic) name characters. HTTP
// headers (Location) and the <link rel="canonical"> href must be ASCII, so
// percent-encode them — encodeURI keeps "/" and "-" intact and escapes Arabic.
// Without this, Astro.redirect() throws a ByteString error → 500 on the page.
const encodedCanonicalPath = encodeURI(canonicalPath);
let currentPath = Astro.url.pathname;
try {
    // pathname may be percent-encoded; compare decoded to avoid redirect loops
    currentPath = decodeURIComponent(currentPath);
} catch {
    // malformed encoding — fall back to the raw pathname
}
if (currentPath !== canonicalPath) {
    // keep query params (utm etc.) across the redirect
    return Astro.redirect(encodedCanonicalPath + Astro.url.search, 301);
}

// Use the tenant's real origin (roka.cashierthru.com) from the proxy headers,
// NOT Astro.url.origin — the Node adapter reports "localhost" behind Nginx,
// which would emit a broken canonical + JSON-LD offer URL.
const siteOrigin = getSiteOrigin(Astro.request, Astro.url);
const canonicalUrl = `${siteOrigin}${encodedCanonicalPath}`;

// SEO metadata
const pageTitle = productData?.name || "تفاصيل المنتج";
const pageDescription =
    productData?.description?.replace(/<[^>]*>/g, " ") ||
    "عرض تفاصيل ومواصفات المنتج";
const pageKeywords = [
    productData?.name,
    productData?.category?.name,
    "منتج",
    "شراء أونلاين",
].filter(Boolean) as string[];
// The product's own photos for link previews (WhatsApp, Facebook, Google) and the schema.
// The API sends `images` (main first, then the gallery) and `product_image`; the store's
// "no image" placeholder doesn't count, so a product without a photo keeps the default preview.
const isRealImage = (url?: string | null): url is string =>
    typeof url === "string" && url !== "" && !/no_image|placeholder/i.test(url);
const productImages = [
    ...(productData?.images ?? []),
    productData?.product_image,
    productData?.main_image,
    ...(productData?.gallery_images ?? []),
    productData?.image,
].filter(isRealImage).filter((url, index, all) => all.indexOf(url) === index);
const productImage: string | undefined = productImages[0];

// Schema.org JSON-LD — the Product plus the store Organization (name / logo /
// about / contact + facebook/instagram via sameAs), built from the tenant's
// settings and linked as the offer's seller by @id, so the brand + social data
// is present on product pages too.
const storeOrg = buildStoreOrganization(settingsData, siteOrigin);
const offerPrice = schemaOfferPrice(productData);
const productSchema = {
    "@context": "https://schema.org",
    "@type": "Product",
    name: productData?.name,
    description: productData?.description?.replace(/<[^>]*>/g, ""),
    image: productImages.length ? productImages : undefined,
    brand: {
        "@type": "Brand",
        name: settingsData?.name || "Store",
    },
    // No offer when the price is 0 ("price on request"): Google refuses or flags a free offer, and the
    // page shows "اطلب السعر" instead (src/lib/price-display.ts). The price is what the customer pays
    // (after the product's discount).
    ...(offerPrice !== null
        ? {
              offers: {
                  "@type": "Offer",
                  url: canonicalUrl,
                  priceCurrency: "EGP",
                  price: offerPrice,
                  // Made from a recipe and an item ran out (API in_stock): tell search engines too.
                  availability: productData?.in_stock === false ? "https://schema.org/OutOfStock" : "https://schema.org/InStock",
                  seller: { "@id": storeOrganizationId(siteOrigin) },
              },
          }
        : {}),
    // No `category`: Google Merchant listings wants a Google product taxonomy value there and flags the
    // store's own category name ("Invalid value in field category", Search Console 2026-11-26).
};
const schema = JSON.stringify([productSchema, storeOrg]);

// Rendered on demand — product ids/slugs are unknown at build time
export const prerender = false;
---

<Layout
    title={pageTitle}
    description={pageDescription}
    keywords={pageKeywords}
    image={productImage}
    favicon={settingsData?.logo}
    canonical={canonicalUrl}
>
    <SettingsProvider
        initialSettings={settingsData}
        isLogin={isLogin}
        cartCount={cartCount}
        token={token}
        client:only="react"
    >
        <!-- Color and Login Handlers -->
        <ColorHandler client:only="react" />
        <LoginHandler client:only="react" />
        <FaviconHandler client:load />

        <!-- Header -->
        <Header client:load />

        <!-- Main Content -->
        <main class="min-h-screen">
            <DetailPage
                product={productData}
                settings={settingsData}
                client:load
            />
        </main>

        <!-- WhatsApp Floating Button -->
        {
            whatsappLink && (
                <a
                    href={whatsappLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="تواصل عبر الواتساب"
                    class="group fixed left-4 top-40 z-50"
                >
                    <div
                        class="
            flex h-12 w-12 items-center overflow-hidden
            rounded-full bg-green-500 text-white shadow-lg
            transition-all duration-300
            group-hover:w-[150px] group-hover:shadow-xl
          "
                    >
                        <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center">
                            <i class="pi pi-whatsapp text-2xl" />
                        </div>
                        <span
                            class="
              max-w-0 translate-x-2 whitespace-nowrap text-sm font-medium
              opacity-0 transition-all duration-300
              group-hover:max-w-[100px] group-hover:translate-x-0 group-hover:opacity-100
            "
                        >
                            تواصل معنا
                        </span>
                    </div>
                    <span class="sr-only">تواصل معنا عبر الواتساب</span>
                </a>
            )
        }

        <!-- Footer -->
        <Footer
            settingsData={settingsData}
            appVersion={appVersion}
            client:visible
        />

        <!-- Toast Notifications -->
        <ToastContainer
            position="bottom-right"
            rtl={true}
            autoClose={3000}
            hideProgressBar={false}
            newestOnTop={true}
            closeOnClick={true}
            pauseOnFocusLoss={true}
            draggable={true}
            pauseOnHover={true}
            theme="light"
            client:only="react"
        />
    </SettingsProvider>

    <!-- Product Structured Data (JSON-LD) -->
    <script is:inline type="application/ld+json" set:html={schema} />
</Layout>
