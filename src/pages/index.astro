---
import Layout from "../layouts/Layout.astro";
import Hero from "@/components/Hero/Hero";
import OfferProducts from "@/components/OfferProducts/Index";
import Categories from "@/components/Categories/Categories";
import ProductsSection from "@/components/Product/ProductsSection";

export const prerender = false;

import Header from "@/layouts/Header/Header";
import Footer from "@/layouts/Footer";
import ColorHandler from "@/layouts/ColorHandler";
import LoginHandler from "@/layouts/LoginHandler";
import SettingsCookieSync from "@/components/common/SettingsCookieSync";
import WhatsAppButton from "@/components/common/WhatsAppButton";
import FaviconHandler from "@/layouts/FaviconHandler";
import { fetchSettings } from "@/hooks/fetchSettings";
import { fetchHook } from "@/hooks/fetch-hook";
import packageJson from "../../package.json";
import { Product } from "@/lib/product/product";

// Get auth token from cookies
const token = Astro.cookies.get("app_token")?.value;

// Get search params for filtering
const searchParams = Astro.url.searchParams;
const categoryParam = searchParams.get("category") || undefined;
const subCategoryParam = searchParams.get("sub_category") || undefined;
const currentPage = Number(searchParams.get("page")) || 1;
const limit = Number(searchParams.get("limit")) || 10;

// URL params are stored as "{id}-{slug}" — extract the numeric ID for API calls
const extractId = (param: string | undefined) => param?.match(/^(\d+)/)?.[1];
const categoryId = extractId(categoryParam);
const subCategoryId = extractId(subCategoryParam);

// ============================================
// PARALLEL API CALLS - Improved SSR Performance
// Using allSettled to prevent one failure from breaking the entire page
// ============================================
const [settingsResult, homeResult] = await Promise.allSettled([
    fetchSettings(token),
    fetchHook({ url: "v1/home", init: {}, token }),
]);

// Extract settings data (handle rejected promises)
const settingsResponse =
    settingsResult?.status === "fulfilled" ? settingsResult.value : null;
const settingsData = settingsResponse?.data ?? null;
const isLogin = settingsResponse?.ok
    ? Boolean(settingsResponse?.is_login)
    : false;
const appVersion = packageJson.version;

// Extract home data
const homeResponse =
    homeResult?.status === "fulfilled" ? homeResult.value : null;
const homeData = homeResponse?.ok ? homeResponse?.data?.data : null;

// Process banner data
const bannerData: any[] = homeData?.banners ?? [];
const showBanner = bannerData.length > 0;

// Process offer products (popular_products from home API)
const offerProducts: any[] = homeData?.popular_products ?? [];
const showOffers = offerProducts.length > 0;

// Process categories
const categoriesData: any[] = homeData?.categories ?? [];
const showCategories = categoriesData.length > 0;

// Handle subcategories — match on the numeric ID extracted from the URL param
const targetFilterCategory = (() => {
    if (!categoryId) {
        return { isFilterCategory: false, isSubCategory: false };
    }
    const cat = categoriesData?.find(
        (item: any) => item.id?.toString() === categoryId,
    );
    return {
        ...(cat || {}),
        isFilterCategory: true,
        isSubCategory: (cat?.subcategories?.length || 0) > 0,
    };
})();

// ============================================
// Products - Fetch separately (depends on category)
// ============================================
let productsData: Product[] = [];
let productsPagination: any = { last_page: 1 };
let showProducts = false;

try {
    const productsUrl = `v1/product${categoryId ? `?category_id=${categoryId}` : ""}${
        subCategoryId ? `&sub_category_id=${subCategoryId}` : ""
    }${subCategoryId || categoryId ? `&` : "?"}page=${currentPage}&limit=${limit}`;

    const productsResponse = await fetchHook({
        url: productsUrl,
        init: {},
    });

    if (productsResponse?.ok && productsResponse?.data?.data) {
        productsData = productsResponse.data.data;
        productsPagination = productsResponse.data.pagination || {
            last_page: 1,
        };
        showProducts = true;
    }
} catch (error) {
    console.error("Error fetching products:", error);
}

// SEO metadata
const pageTitle = settingsData?.name || "الرئيسية - منصة الأعمال";
const pageDescription = settingsData?.about_us || "منصة إدارة الأعمال الصغيرة";
const pageKeywords = settingsData?.keywords || [
    "أعمال صغيرة",
    "متجر إلكتروني",
    "تجارة إلكترونية",
];
---

<Layout
    title={pageTitle}
    description={pageDescription}
    keywords={pageKeywords}
    image={settingsData?.logo}
    favicon={settingsData?.logo}
>
    <ColorHandler client:only="react" />
    <LoginHandler client:only="react" />
    <FaviconHandler client:load />

    <Header
        currentPath={Astro.url.pathname}
        initialIsLoggedIn={isLogin}
        settingsData={settingsData || undefined}
        client:load
    />

    <main class="min-h-screen">
        {showBanner && <Hero bannerData={bannerData} client:load />}

        {
            showOffers && (
                <OfferProducts offerProducts={offerProducts} client:visible />
            )
        }

        {
            showCategories && (
                <Categories
                    categoriesData={categoriesData}
                    isSuccess={true}
                    targetFilterCategory={targetFilterCategory}
                    client:visible
                />
            )
        }

        <section class="py-10" id="products">
            <ProductsSection
                products={showProducts
                    ? {
                          data: productsData,
                          isSuccess: true,
                          pagination: productsPagination,
                      }
                    : { isSuccess: false }}
                defaultImage={settingsData?.product_default_image}
                client:visible
            />
        </section>
    </main>

    <WhatsAppButton phone={settingsData?.whatsapp_phone} client:idle />
    <SettingsCookieSync settings={settingsData} client:load />

    <Footer
        settingsData={settingsData}
        appVersion={appVersion}
        client:visible
    />
</Layout>
