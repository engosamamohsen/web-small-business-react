---
import Layout from "../layouts/Layout.astro";
import Hero from "@/components/Hero/Hero";
import Categories from "@/components/Categories/Categories";
import ProductsSection from "@/components/Product/ProductsSection";
import MealHelperPrompt from "@/components/MealHelper/MealHelperPrompt";
import ThemedHero from "@/components/Themed/ThemedHero";
import CategoryNav from "@/components/Themed/CategoryNav";
import ThemedProducts from "@/components/Themed/ThemedProducts";
import { resolveTheme } from "@/themes/registry";

export const prerender = false;

import Header from "@/layouts/Header/Header";
import Footer from "@/layouts/Footer";
import ColorHandler from "@/layouts/ColorHandler";
import LoginHandler from "@/layouts/LoginHandler";
import SettingsCookieSync from "@/components/common/SettingsCookieSync";
import WhatsAppButton from "@/components/common/WhatsAppButton";
import { ToastContainer } from "react-toastify";
import FaviconHandler from "@/layouts/FaviconHandler";
import { fetchSettings } from "@/hooks/fetchSettings";
import { fetchHook } from "@/hooks/fetch-hook";
import { getSiteOrigin } from "@/lib/site-origin";
import { buildStoreOrganization, normalizeKeywords } from "@/lib/seo";
import { resolveWhatsappNumber } from "@/lib/whatsapp-order";
import packageJson from "../../package.json";
import { Product } from "@/lib/product/product";
import { productsUrl as buildProductsUrl, filtersFromParams } from "@/lib/products-query";
import { storeConfig } from "@/lib/store-config";
import ProductFilters from "@/components/products/ProductFilters";
import { isFoodStore, productsWording } from "@/lib/shop-type";
import { resizedUrl, storeSrcSet } from "@/lib/responsive-image";
import SalonHome from "@/components/Booking/SalonHome.astro";
import { BookingApiError, getCatalog } from "@/lib/booking/api";
import type { BookingCatalog } from "@/lib/booking/types";
import { buildSalonBusinessJsonLd, salonHomeMeta, servicesFirstHome, storeHasProducts } from "@/lib/booking/salon-home";

// Get auth token from cookies
const token = Astro.cookies.get("app_token")?.value;

// Get search params for filtering
const searchParams = Astro.url.searchParams;
const categoryParam = searchParams.get("category") || undefined;
const subCategoryParam = searchParams.get("sub_category") || undefined;
const currentPage = Number(searchParams.get("page")) || 1;
const limit = Number(searchParams.get("limit")) || 10;

// URL params are stored as "{id}-{slug}" — extract the numeric ID for API calls
const extractId = (param: string | undefined) => param?.match(/^(\d+)/)?.[1];
const categoryId = extractId(categoryParam);
const subCategoryId = extractId(subCategoryParam);

// Products list — paginated v1/product, plus search / price / sort (src/lib/products-query.ts)
const productsUrl = buildProductsUrl(searchParams);

// Per-request admin API base URL set by middleware (tenant-aware).
const apiBase = Astro.locals.apiBase;

// A beauty / service store that takes bookings opens with its services (src/lib/booking/salon-home.ts).
// Its type and booking switch come from the middleware's settings, so the services load with the rest.
const salonCandidate = servicesFirstHome(Astro.locals.shopType, Astro.locals.booking?.enabled);

// ============================================
// PARALLEL API CALLS - settings + banner + categories + products in one round trip
// Using allSettled to prevent one failure from breaking the entire page
// ============================================
const [settingsResult, bannerResult, categoriesResult, productsResult, catalogResult] =
    await Promise.allSettled([
        fetchSettings(token, false, apiBase),
        fetchHook({ url: "v1/banner", init: {}, token, baseUrl: apiBase }),
        fetchHook({ url: "v1/categories", init: {}, token, baseUrl: apiBase }),
        fetchHook({ url: productsUrl, init: {}, baseUrl: apiBase }),
        salonCandidate ? getCatalog(apiBase) : Promise.resolve(null),
    ]);

// Extract settings data (handle rejected promises)
const settingsResponse =
    settingsResult?.status === "fulfilled" ? settingsResult.value : null;
const settingsData = settingsResponse?.data ?? null;
const isLogin = settingsResponse?.ok
    ? Boolean(settingsResponse?.is_login)
    : false;
const appVersion = packageJson.version;

// Banner — GET v1/banner → {status, message, data: [...]}
// Section is hidden entirely when the API fails or returns an empty list.
const bannerResponse =
    bannerResult?.status === "fulfilled" ? bannerResult.value : null;
const bannerData: any[] =
    bannerResponse?.ok && Array.isArray(bannerResponse?.data?.data)
        ? bannerResponse.data.data
        : [];
const showBanner = bannerData.length > 0;

// Categories — GET v1/categories → {status, message, data: {data: [...]}}
// Used for the category filter only (products come from v1/product).
// Only categories that contain active products are shown, and the heavy
// products_active payload is stripped before reaching the client island.
const categoriesResponse =
    categoriesResult?.status === "fulfilled" ? categoriesResult.value : null;
const allCategories: any[] =
    categoriesResponse?.ok &&
    Array.isArray(categoriesResponse?.data?.data?.data)
        ? categoriesResponse.data.data.data
        : [];
const categoriesData: any[] = allCategories
    .filter((category: any) => (category?.products_active?.length ?? 0) > 0)
    .map(({ products_active, ...category }: any) => category);
const showCategories = categoriesData.length > 0;

// Handle subcategories — match on the numeric ID extracted from the URL param
const targetFilterCategory = (() => {
    if (!categoryId) {
        return { isFilterCategory: false, isSubCategory: false };
    }
    const cat = categoriesData?.find(
        (item: any) => item.id?.toString() === categoryId,
    );
    return {
        ...(cat || {}),
        isFilterCategory: true,
        isSubCategory: (cat?.subcategories?.length || 0) > 0,
    };
})();

// Products — extract from the parallel result
let productsData: Product[] = [];
let productsPagination: any = { last_page: 1 };
let productsPriceRange: { min: number | null; max: number | null } | null = null;
let showProducts = false;

const productsResponse =
    productsResult?.status === "fulfilled" ? productsResult.value : null;
if (productsResponse?.ok && productsResponse?.data?.data) {
    productsData = productsResponse.data.data;
    productsPagination = productsResponse.data.pagination || { last_page: 1 };
    productsPriceRange = productsResponse.data.price_range ?? null;
    showProducts = true;
}

// Salon home: services first. If the API says booking is off after all, the page is the usual one;
// if the services just failed to load, the salon home still offers the book button.
const salonCatalog: BookingCatalog | null =
    catalogResult.status === "fulfilled" ? catalogResult.value : null;
const salonHome =
    salonCandidate &&
    !(catalogResult.status === "rejected" && catalogResult.reason instanceof BookingApiError && catalogResult.reason.kind === "off");
// The cart, product search and product sections stay on a salon home only when it sells products.
const showShop = !salonHome || storeHasProducts(allCategories, productsData);

// Website theme (dashboard → Website settings): which hero, category and product
// layout this page uses. Classic keeps the original components.
const theme = resolveTheme(Astro.locals.theme);
const layout = theme.layout;
const isClassic = theme.key === "classic";
// A restaurant theme on an online shop says "منتجاتنا", not "المنيو".
const foodStore = isFoodStore(settingsData?.shop_type);
const wording = productsWording(settingsData?.shop_type, layout.productsTitle, layout.introCta);
// A salon home draws its own intro (SalonHome), so there the themed hero only shows banners.
const showThemedHero = !isClassic && (showBanner ? layout.hero !== "overlay" : layout.intro && !salonHome);

// The first banner is the page's largest image: let the browser start it with the HTML.
// Same srcset/sizes as the hero <img> (100vw, up to 1600 px), so it is fetched once.
const firstBanner: string | undefined = showBanner ? bannerData[0]?.image : undefined;
const bannerSrcSet = storeSrcSet(firstBanner, 1600);
const preloadImage = firstBanner
    ? bannerSrcSet
        ? { href: resizedUrl(firstBanner, 640), srcset: bannerSrcSet, sizes: "100vw" }
        : { href: firstBanner }
    : undefined;

// SEO metadata — all sourced from the tenant's settings API (per request).
// A salon home names its services in the title and description.
const salonServices = salonCatalog?.services ?? [];
const salonMeta = salonHome ? salonHomeMeta(settingsData?.name, settingsData?.about_us, salonServices) : null;
const pageTitle = salonMeta?.title || settingsData?.name || "الرئيسية - منصة الأعمال";
// about_us can carry CRLF line breaks; collapse to one clean line.
const pageDescription =
    salonMeta?.description ||
    settingsData?.about_us?.replace(/\s+/g, " ").trim() ||
    "منصة إدارة الأعمال الصغيرة";
const pageKeywords = normalizeKeywords(
    settingsData?.keywords,
    salonHome && salonServices.length
        ? salonServices.slice(0, 10).map((s) => s.name)
        : ["أعمال صغيرة", "متجر إلكتروني", "تجارة إلكترونية"],
);

// Organization (built from the tenant's settings — name/logo/about/contact +
// facebook/instagram via sameAs) + WebSite structured data. Helps Google build
// the store's knowledge panel and a sitelinks search box. Tenant origin is
// resolved from the request inside Layout/SEO.
const siteOrigin = getSiteOrigin(Astro.request, Astro.url);
const storeName = settingsData?.name || "المتجر";
// A salon home adds the store as a BeautySalon / LocalBusiness with its services, and offers no
// product search box unless it sells products.
const homeJsonLd = [
    buildStoreOrganization(settingsData, siteOrigin),
    ...(salonHome ? [buildSalonBusinessJsonLd(settingsData, siteOrigin, salonServices)] : []),
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: storeName,
        url: siteOrigin,
        ...(showShop
            ? {
                  potentialAction: {
                      "@type": "SearchAction",
                      target: `${siteOrigin}/?q={search_term_string}`,
                      "query-input": "required name=search_term_string",
                  },
              }
            : {}),
    },
];
---

<Layout
    title={pageTitle}
    description={pageDescription}
    keywords={pageKeywords}
    image={settingsData?.logo}
    favicon={settingsData?.logo}
    jsonLd={homeJsonLd}
    preloadImage={preloadImage}
>
    <ColorHandler client:only="react" />
    <LoginHandler client:only="react" />
    <FaviconHandler client:idle />

    <Header
        currentPath={Astro.url.pathname}
        initialIsLoggedIn={isLogin}
        settingsData={settingsData || undefined}
        hideShop={!showShop}
        client:load
    />
    <ToastContainer position="top-right" rtl={true} client:idle />

    <main class="min-h-screen">
        {showBanner && !showThemedHero && <Hero bannerData={bannerData} client:load />}
        {
            showThemedHero && (
                <ThemedHero
                    slides={bannerData}
                    storeName={settingsData?.name}
                    about={settingsData?.about_us}
                    cta={wording.cta}
                    motion={theme.motion}
                    client:load
                />
            )
        }

        {
            salonHome && (
                <SalonHome
                    storeName={storeName}
                    about={settingsData?.about_us}
                    catalog={salonCatalog}
                    hasBanner={showBanner}
                />
            )
        }

        {
            showShop && showCategories && !isClassic && layout.categories !== "swiper" && (
                <CategoryNav
                    categories={categoriesData}
                    variant={layout.categories}
                    title={layout.categoriesTitle}
                    initialCategory={categoryParam ?? null}
                    client:visible
                />
            )
        }

        {
            showShop && showCategories && (isClassic || layout.categories === "swiper") && (
                <Categories
                    categoriesData={categoriesData}
                    isSuccess={true}
                    targetFilterCategory={targetFilterCategory}
                    client:visible
                />
            )
        }

        {showProducts && foodStore && <MealHelperPrompt />}

        {/* Search, price and sort (full e-commerce stores only; other stores look exactly as before) */}
        {showShop && storeConfig.isPremium && (
            <ProductFilters
                filters={filtersFromParams(searchParams)}
                priceRange={productsPriceRange}
                total={productsPagination?.total ?? null}
                client:load
            />
        )}

        {
            showShop && !isClassic && (
                <section id="products">
                    <ThemedProducts
                        products={showProducts
                            ? { data: productsData, pagination: productsPagination }
                            : { data: [] }}
                        defaultImage={settingsData?.product_default_image}
                        layout={layout.products}
                        title={wording.title}
                        client:visible
                    />
                </section>
            )
        }

        {showShop && isClassic && <section class="py-10" id="products">
            <ProductsSection
                products={showProducts
                    ? {
                          data: productsData,
                          isSuccess: true,
                          pagination: productsPagination,
                      }
                    : { isSuccess: false }}
                defaultImage={settingsData?.product_default_image}
                client:visible
            />
        </section>}
    </main>

    <WhatsAppButton phone={resolveWhatsappNumber(settingsData)} client:idle />
    <SettingsCookieSync settings={settingsData} client:idle />

    <Footer
        settingsData={settingsData}
        appVersion={appVersion}
        client:visible
    />
</Layout>
