---
import Layout from "../layouts/Layout.astro";

// Rendered per request, not baked at build time (QA 2026-11-08, M1; owner approved 2026-11-09): a baked
// 404.html showed whichever store PUBLIC_BASE_URL pointed to at build time, on every host. Now the middleware
// runs first, so each store gets its own 404 page and a shipping company gets its carrier 404 (the
// middleware rewrites an unknown carrier path to /carrier, in the visitor's language).
export const prerender = false;

Astro.response.status = 404;
---

<Layout title="404 - الصفحة غير موجودة">
    <section class="flex min-h-screen items-center justify-center bg-gray-50">
        <div class="text-center p-8">
            <h1 class="text-8xl font-bold text-[var(--main-color)] mb-4">
                404
            </h1>
            <p class="text-2xl text-gray-700 mb-8">
                الصفحة التي تبحث عنها غير موجودة
            </p>
            <a
                href="/"
                data-astro-prefetch="load"
                class="inline-block rounded-lg bg-[var(--main-color)] px-8 py-3 text-white font-semibold hover:opacity-90 transition-opacity"
            >
                العودة للرئيسية
            </a>
        </div>
    </section>
</Layout>
