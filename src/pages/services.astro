---
// /services — the store's bookable services by category (docs/talent-booking.md 5, phase D4).
// Server-rendered, no island: each "احجز" is a plain link to /book?service=<id>.
// When the store doesn't take bookings the page says so and makes no booking call.
import BookingShell from "@/components/Booking/BookingShell.astro";
import BookingUnavailable from "@/components/Booking/BookingUnavailable.astro";
import ServicesList from "@/components/Booking/ServicesList.astro";
import { fetchSettings } from "@/hooks/fetchSettings";
import { BookingApiError, getCatalog } from "@/lib/booking/api";
import { t } from "@/lib/booking/strings";
import type { BookingCatalog } from "@/lib/booking/types";
import { SERVICES_PATH, encodedServicePath } from "@/lib/booking/seo";
import { getSiteOrigin } from "@/lib/site-origin";

export const prerender = false;

const token = Astro.cookies.get("app_token")?.value;
const settingsResponse = await fetchSettings(token, false, Astro.locals.apiBase);
const settingsData = settingsResponse?.data ?? null;
const storeName = settingsData?.name || "المتجر";

let enabled = Boolean(Astro.locals.booking?.enabled);
let catalog: BookingCatalog | null = null;
let failed = false;
if (enabled) {
    try {
        catalog = await getCatalog(Astro.locals.apiBase);
    } catch (error) {
        if (error instanceof BookingApiError && error.kind === "off") enabled = false;
        else failed = true;
    }
}
if (!enabled) Astro.response.status = 404;

const siteOrigin = getSiteOrigin(Astro.request, Astro.url);
const canonical = `${siteOrigin}${SERVICES_PATH}`;
// The list for search engines: each service links to its own page.
const jsonLd = catalog?.services.some((s) => s.slug)
    ? {
          "@context": "https://schema.org",
          "@type": "ItemList",
          itemListElement: catalog.services
              .filter((s) => s.slug)
              .map((s, i) => ({ "@type": "ListItem", position: i + 1, name: s.name, url: `${siteOrigin}${encodedServicePath(s.slug!)}` })),
      }
    : undefined;
---

<BookingShell
    title={`${t.servicesTitle} - ${storeName}`}
    description={`${t.servicesIntro} ${storeName}`}
    settingsData={settingsData}
    isLogin={Boolean(settingsResponse?.is_login)}
    cartCount={settingsResponse?.cart_count ?? 0}
    token={token}
    noindex={!enabled}
    canonical={canonical}
    jsonLd={jsonLd}
>
    <div class="ct-bk-wrap">
        {!enabled && <BookingUnavailable />}
        {enabled && failed && (
            <div class="ct-bk-card ct-bk-empty" role="alert">
                <p>{t.loadFailed}</p>
                <a class="ct-bk-btn" href="/services">{t.retry}</a>
            </div>
        )}
        {enabled && catalog && (
            <>
                <h1 class="ct-bk-title">{t.servicesTitle}</h1>
                <p class="ct-bk-lead">{t.servicesIntro}</p>
                <ServicesList catalog={catalog} />
            </>
        )}
    </div>
</BookingShell>
