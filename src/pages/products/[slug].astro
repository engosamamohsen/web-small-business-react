---
import { fetchHook } from "@/hooks/fetch-hook";
import { buildProductPath } from "@/lib/product-url";
import type { ProductType } from "@/lib/types";

// Legacy route — product pages now live at /product/{id}-{slug}.
// Kept as a permanent redirect so old indexed/shared links keep working.
const { slug } = Astro.params as { slug: string };

if (!slug) {
    return Astro.redirect("/404");
}

// Old links ended with the id ("ft-shaorma-frakh-8", "{name}-{id}", or bare "{id}").
// Fall back to leading digits in case a new-style "{id}-{slug}" lands here.
const lastSegment = slug.split("-").pop() ?? "";
const id = /^\d+$/.test(lastSegment)
    ? lastSegment
    : (slug.match(/^(\d+)/)?.[1] ?? null);

if (!id) {
    return Astro.redirect("/404");
}

// Resolve the canonical slug from the same product-details API
let productData: ProductType | null = null;
try {
    const response = await fetchHook({
        url: `v1/product-details?product_id=${id}`,
        init: {},
    });

    if (response?.ok && response?.data?.data) {
        productData = response.data.data;
    }
} catch (error) {
    console.error("Error fetching product details:", error);
}

if (!productData) {
    return Astro.redirect("/404");
}

return Astro.redirect(buildProductPath({ ...productData, id }), 301);

export const prerender = false;
---
