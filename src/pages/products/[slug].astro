---
import { lookupProduct } from "@/lib/product-lookup";
import { buildProductPath } from "@/lib/product-url";
import type { ProductType } from "@/lib/types";

// Rendered on demand (declared up top so it isn't flagged as unreachable after
// the early-return redirects below).
export const prerender = false;

// Legacy route — product pages now live at /product/{id}/{name}.
// Kept as a permanent redirect so old indexed/shared links keep working.
const { slug } = Astro.params as { slug: string };

if (!slug) {
    return Astro.rewrite("/404");
}

// Old links ended with the id ("ft-shaorma-frakh-8", "{name}-{id}", or bare "{id}").
// Fall back to leading digits in case a new-style "{id}-{slug}" lands here.
const lastSegment = slug.split("-").pop() ?? "";
const id = /^\d+$/.test(lastSegment)
    ? lastSegment
    : (slug.match(/^(\d+)/)?.[1] ?? null);

if (!id) {
    return Astro.rewrite("/404");
}

// Resolve the canonical address from the same product-details API (this store's API, set per request
// by the middleware). Missing: 404 here; API down after one more try: 503 "try again"
// (src/lib/product-lookup.ts), never a redirect to /404.
const lookup = await lookupProduct(id, Astro.locals.apiBase);
if (lookup.kind === "missing") {
    return Astro.rewrite("/404");
}
if (lookup.kind === "unavailable") {
    return Astro.rewrite("/unavailable");
}
const productData: ProductType = lookup.product;

// API id + slug are authoritative; keep query params (utm etc.) across the redirect.
// encodeURI escapes any non-ASCII (Arabic) name chars so the Location header is
// valid ASCII — raw Arabic would throw a ByteString error → 500.
return Astro.redirect(encodeURI(buildProductPath(productData)) + Astro.url.search, 301);
---
