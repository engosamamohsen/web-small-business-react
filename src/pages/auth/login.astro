---
import ThemeHead from "@/themes/ThemeHead.astro";
import { resolveTheme } from "@/themes/registry";
import LoginForm from "@/components/auth/LoginForm";
import { fetchSettings } from "@/hooks/fetchSettings";
import { storeConfig } from "@/lib/store-config";

// BASIC plan: authentication is disabled — this screen doesn't exist
if (!storeConfig.canAuthenticate) {
    return Astro.redirect("/");
}

// Fetch public settings for the page
const settingsResponse = await fetchSettings(undefined, false, Astro.locals.apiBase);
const settingsData = settingsResponse?.data ?? null;
const socialLogin = Astro.locals.socialLogin ?? [];
// Back from Google / Facebook without signing in (see /customer-login on the dashboard).
const socialErrors: Record<string, string> = {
    cancelled: "تم إلغاء تسجيل الدخول.",
    expired: "انتهت صلاحية تسجيل الدخول. حاول مرة أخرى.",
    failed: "تعذر تسجيل الدخول بهذا الحساب. حاول مرة أخرى.",
};
const socialError = socialErrors[Astro.url.searchParams.get("social_error") ?? ""] ?? null;

// SEO metadata
const siteName = settingsData?.name || "المتجر";
const pageTitle = `تسجيل الدخول | ${siteName}`;
const pageDescription =
    settingsData?.about_us || "انضم إلينا واحصل على تجربة مميزة";
const pageKeywords = [
    ...(settingsData?.keywords || []),
    "تسجيل",
    "دخول",
    "تسجيل الدخول",
];

// Set to server-side rendering
export const prerender = false;
---

<!doctype html>
<html lang="ar" dir="rtl" data-theme={resolveTheme(Astro.locals.theme).key}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{pageTitle}</title>
        <meta name="description" content={pageDescription} />
        <meta name="keywords" content={pageKeywords.join(", ")} />

        <!-- Preload critical fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <ThemeHead />

        <!-- Open Graph -->
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:type" content="website" />
        {
            settingsData?.logo && (
                <meta property="og:image" content={settingsData.logo} />
            )
        }

        <!-- Favicon -->
        {settingsData?.logo && <link rel="icon" href={settingsData.logo} />}

        <!-- CSS Imports -->
        <link rel="stylesheet" href="/src/styles/globals.css" />
        <link rel="stylesheet" href="/node_modules/nprogress/nprogress.css" />
        <link
            rel="stylesheet"
            href="/node_modules/react-toastify/dist/ReactToastify.css"
        />
        <link
            rel="stylesheet"
            href="/node_modules/primereact/resources/themes/lara-light-cyan/theme.css"
        />
        <link rel="stylesheet" href="/node_modules/primeicons/primeicons.css" />
    </head>
    <body class="relative font-cairo bg-gray-50">
        {socialError && (
            <p role="alert" style="margin:24px auto 0;max-width:350px;padding:12px 16px;border-radius:8px;background:#fef2f2;color:#b91c1c;text-align:center;font-size:14px;font-weight:600;">
                {socialError}
            </p>
        )}
        <LoginForm initSettings={settingsData ?? {}} socialLogin={socialLogin} client:only="react" />
    </body>
</html>

<style is:global>
    :root {
        --font-cairo: "Cairo", sans-serif;
    }

    body {
        font-family: var(--font-cairo);
    }
</style>
