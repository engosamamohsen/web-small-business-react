---
// Stylesheets are imported so they are bundled: the old <link href="/src/..." / "/node_modules/...">
// tags only worked on the dev server and were 404s in production (the page lost all its styles).
import "@/styles/fonts.css";
import "@/styles/globals.css";
import "nprogress/nprogress.css";
import "react-toastify/dist/ReactToastify.css";
import "@/styles/primereact-theme";
import "primeicons/primeicons.css";
import ThemeHead from "@/themes/ThemeHead.astro";
import { resolveTheme } from "@/themes/registry";
import RegisterForm from "@/components/auth/RegisterForm";
import { fetchSettings } from "@/hooks/fetchSettings";
import { storeConfig } from "@/lib/store-config";

// BASIC plan: authentication is disabled — this screen doesn't exist
if (!storeConfig.canAuthenticate) {
    return Astro.redirect("/");
}

// Fetch public settings for the page
const settingsResponse = await fetchSettings(undefined, false, Astro.locals.apiBase);
const settingsData = settingsResponse?.data ?? null;
const socialLogin = Astro.locals.socialLogin ?? [];

// SEO metadata
const siteName = settingsData?.name || "المتجر";
const pageTitle = `إنشاء حساب جديد | ${siteName}`;
const pageDescription =
    settingsData?.about_us || "أنشئ حساب جديد للوصول إلى جميع ميزات موقعنا";
const pageKeywords = [
    ...(settingsData?.keywords || []),
    "تسجيل",
    "حساب جديد",
    "إنشاء حساب",
];

// Set to server-side rendering
export const prerender = false;
---

<!doctype html>
<html lang="ar" dir="rtl" data-theme={resolveTheme(Astro.locals.theme).key}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{pageTitle}</title>
        <meta name="description" content={pageDescription} />
        <meta name="keywords" content={pageKeywords.join(", ")} />
        <!-- Cairo is self-hosted (src/styles/fonts.css) -->
        <link rel="preload" href="/fonts/cairo/cairo-arabic.woff2" as="font" type="font/woff2" crossorigin />
        <ThemeHead />

        <!-- Open Graph -->
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:type" content="website" />
        {
            settingsData?.logo && (
                <meta property="og:image" content={settingsData.logo} />
            )
        }

        <!-- Favicon -->
        {settingsData?.logo && <link rel="icon" href={settingsData.logo} />}
    </head>
    <body class="relative font-cairo bg-gray-50">
        <RegisterForm initSettings={settingsData ?? {}} socialLogin={socialLogin} client:only="react" />
    </body>
</html>

<style is:global>
    :root {
        --font-cairo: "Cairo", sans-serif;
    }

    body {
        font-family: var(--font-cairo);
    }
</style>
