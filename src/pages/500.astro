---
/**
 * 500 Error Page
 * 
 * Displayed when server error occurs
 */
import BaseLayout from '@/layouts/BaseLayout.astro';

// Static page
export const prerender = true;
---

<BaseLayout title="خطأ في الخادم" noindex={true}>
  <main class="flex min-h-[60vh] items-center justify-center">
    <div class="text-center">
      <h1 class="mb-4 text-6xl font-bold text-red-500">500</h1>
      <h2 class="mb-4 text-2xl font-semibold text-[var(--second-font-color)]">
        خطأ في الخادم
      </h2>
      <p class="mb-8 text-gray-600">
        عذراً، حدث خطأ غير متوقع. يرجى المحاولة مرة أخرى لاحقاً
      </p>
      <div class="flex justify-center gap-4">
        <button
          onclick="window.location.reload()"
          class="inline-block rounded-lg bg-[var(--main-color)] px-6 py-3 text-white transition-opacity hover:opacity-90"
        >
          إعادة المحاولة
        </button>
        <a
          href="/"
          class="inline-block rounded-lg border border-[var(--main-color)] px-6 py-3 text-[var(--main-color)] transition-colors hover:bg-[var(--main-color)] hover:text-white"
        >
          العودة للصفحة الرئيسية
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
