---
import Layout from "../layouts/Layout.astro";
---

<Layout title="500 - خطأ في الخادم">
    <section class="flex min-h-screen items-center justify-center bg-gray-50">
        <div class="text-center p-8">
            <h1 class="text-8xl font-bold text-red-500 mb-4">500</h1>
            <p class="text-2xl text-gray-700 mb-4">حدث خطأ في الخادم</p>
            <p class="text-gray-600 mb-8">
                نعتذر عن الإزعاج، يرجى المحاولة مرة أخرى لاحقاً
            </p>
            <a
                href="/"
                data-astro-prefetch="load"
                class="inline-block rounded-lg bg-[var(--main-color)] px-8 py-3 text-white font-semibold hover:opacity-90 transition-opacity"
            >
                العودة للرئيسية
            </a>
        </div>
    </section>
</Layout>
