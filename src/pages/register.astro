---
/**
 * Register Page - New user registration
 * 
 * Features:
 * - Form validation with Zod
 * - Email verification flow
 * - Social signup (Google via Firebase)
 */
import AuthLayout from '@/layouts/AuthLayout.astro';
import RegisterForm from '@/components/Auth/RegisterForm';

// Static page - register form handles auth client-side
export const prerender = true;
---

<AuthLayout title="إنشاء حساب">
  <div class="w-full max-w-md">
    <div class="boxFrom rounded-lg bg-white p-8 shadow-lg">
      <h1 class="mb-6 text-center text-2xl font-bold text-[var(--second-font-color)]">
        إنشاء حساب جديد
      </h1>
      
      <!-- Register Form - React Island for form handling -->
      <RegisterForm client:load />
      
      <div class="mt-6 text-center text-sm text-gray-600">
        <p>
          لديك حساب بالفعل؟{' '}
          <a href="/login" class="text-[var(--main-color)] hover:underline">
            تسجيل الدخول
          </a>
        </p>
      </div>
    </div>
  </div>
</AuthLayout>
