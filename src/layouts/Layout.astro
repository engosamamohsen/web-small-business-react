---
import SEO from "../components/SEO.astro";
import Analytics from "../components/Analytics.astro";
import WebVitals from "../components/WebVitals.astro";
import Tracking from "../components/Tracking/Tracking.astro";
import MealHelperFab from "../components/MealHelper/MealHelperFab";
import { getSiteOrigin } from "@/lib/site-origin";
import { resolveTheme, fontsHref, THEME_PREVIEW_PARAM } from "@/themes/registry";
import { isFoodStore } from "@/lib/shop-type";

// CSS Imports
import "../styles/globals.css";
import "../styles/themes.css";
import "nprogress/nprogress.css";
import "react-toastify/dist/ReactToastify.css";
import "primereact/resources/themes/lara-light-cyan/theme.css";
import "primeicons/primeicons.css";

interface Props {
    title: string;
    description?: string;
    keywords?: string[];
    image?: string;
    imageWidth?: number;
    imageHeight?: number;
    favicon?: string;
    canonical?: string;
    noindex?: boolean;
    jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
    title,
    description = "منصة إدارة الأعمال الصغيرة",
    keywords = [],
    image,
    imageWidth,
    imageHeight,
    favicon,
    canonical,
    noindex = false,
    jsonLd,
} = Astro.props;

// Resolve the requesting tenant's own origin (roka.cashierthru.com, …) from the
// proxy headers — the Node adapter leaves Astro.url.host as "localhost" behind
// Nginx, and Astro.site is the shared base domain, so neither can be trusted for
// per-tenant canonical / Open Graph URLs.
const siteOrigin = getSiteOrigin(Astro.request, Astro.url);

// Floating "help me choose" button on every storefront page, except the helper
// page itself, the lockout screen and prebuilt error pages (no tenant there).
const path = Astro.url.pathname;
// Website theme (dashboard → Website settings), resolved per request in middleware.
const theme = resolveTheme(Astro.locals.theme);
const themeFonts = fontsHref(theme);
const themePreview = Boolean(Astro.locals.themePreview);

// Store mode for the browser (src/lib/store-config.ts), printed before any island hydrates.
const storeBoot = JSON.stringify({
    plan: Astro.locals.plan === "premium" ? "premium" : "basic",
    socialLogin: Astro.locals.socialLogin ?? [],
    onlinePayment: Boolean(Astro.locals.onlinePayment),
}).replace(/</g, "\\u003c");

const showMealHelper =
    !Astro.isPrerendered && path !== "/helper" && path !== "/store-unavailable" &&
    isFoodStore(Astro.locals.shopType);
---

<!doctype html>
<html lang="ar" dir="rtl" data-theme={theme.key} data-motion={theme.motion}>
    <head>
        <meta charset="UTF-8" />
        <script is:inline set:html={`(function(b){window.__CT_PLAN__=b.plan;window.__CT_STORE__=b;})(${storeBoot});`}></script>
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <!-- Scroll reveals (src/components/motion/scroll-reveal.ts): switched on before first paint so marked
             content starts hidden, never for Classic or reduced motion, and dropped if the module never starts. -->
        <script is:inline>(function(d){const m=d.getAttribute("data-motion");if(!m||m==="none"||!window.matchMedia||matchMedia("(prefers-reduced-motion: reduce)").matches)return;d.classList.add("ct-motion");setTimeout(function(){if(!window.__ctReveal)d.classList.remove("ct-motion")},4000)})(document.documentElement);</script>

        <!-- Preload critical fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        {themeFonts && <link href={themeFonts} rel="stylesheet" />}

        <!-- Favicon -->
        <link rel="icon" type="image/png" href={favicon || "/favicon.ico"} />
        <link rel="shortcut icon" href={favicon || "/favicon.ico"} />
        <link rel="apple-touch-icon" href={favicon || "/favicon.ico"} />

        <!-- SEO Component -->
        <SEO
            title={title}
            description={description}
            keywords={keywords}
            image={image}
            imageWidth={imageWidth}
            imageHeight={imageHeight}
            canonical={canonical}
            origin={siteOrigin}
            noindex={noindex}
            jsonLd={jsonLd}
        />

        <!-- Analytics -->
        <Analytics />

        <!-- Web Vitals -->
        <WebVitals />

        <!-- Global error handler -->
        <script is:inline>
            window.addEventListener("error", (event) => {
                console.error("Global error:", event.error);
            });

            window.addEventListener("unhandledrejection", (event) => {
                console.error("Unhandled rejection:", event.reason);
            });
        </script>

        <!-- Tracking & pixels from the dashboard; last, so pasted header code can't displace the tags above -->
        <Tracking part="head" />
    </head>
    <body class="relative font-cairo">
        <Tracking part="bodyStart" />
        {
            themePreview && (
                <div class="ct-preview-bar" role="status">
                    <span>أنت تعاين ثيم «{theme.name}».<span class="ct-preview-bar__more"> يظهر لك وحدك، وعملاؤك يرون ثيمك الحالي.</span></span>
                    <a href={`?${THEME_PREVIEW_PARAM}=off`}>إنهاء المعاينة</a>
                </div>
            )
        }
        <slot />
        {showMealHelper && <MealHelperFab lifted={path.startsWith("/product/")} client:idle />}
        <Tracking part="bodyEnd" />
        <script>
            import { installReveal } from "@/components/motion/scroll-reveal";
            installReveal();
        </script>
    </body>
</html>

<style is:global>
    :root {
        --font-cairo: "Cairo", sans-serif;
    }

    body {
        font-family: var(--font-cairo);
    }
</style>
