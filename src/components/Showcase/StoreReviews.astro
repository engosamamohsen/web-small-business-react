---
// "What our customers say" on the home page of EVERY theme, Classic included (owner, 2026-11-22: "must
// appear last reviews in home in all templates"; the second Classic exception after the photo gallery).
// The reviews are the ones the owner chose in the panel / Admin App (status published): newest first,
// name, stars and text only, never a phone. No chosen review: index.astro renders nothing at all.
//
// A horizontal strip that scrolls on its own (CSS only, no JS): the cards are drawn twice and the track
// slides by half its width, so the loop has no jump. It pauses on hover and keyboard focus, and with
// "reduce motion" it becomes a normal swipeable row. 1–2 reviews: a still, centred row.
// Self-contained like StoreGallery.astro: inline styles, theme tokens with neutral fallbacks for Classic.
import type { PublicReview } from "@/lib/reviews/api";
import { initialOf, reviewsStrip } from "@/lib/reviews/home";
import { reviewsHref, reviewsStrings, type ReviewsLang } from "@/lib/reviews/strings";

interface Props {
    reviews: PublicReview[];
    /** Arabic by default; English with ?lang=en on the home page (index.astro). */
    lang?: ReviewsLang;
}

const { reviews, lang = "ar" } = Astro.props;
const strip = reviewsStrip(reviews);
const t = reviewsStrings(lang);

const css = `
.ct-hr { padding-block: 2.5rem; color: var(--t-ink, #1f2328); overflow: hidden; }
.ct-hr__wrap { max-width: 1280px; margin-inline: auto; padding-inline: 1rem; }
@media (min-width: 640px) { .ct-hr__wrap { padding-inline: 1.5rem; } }
.ct-hr__head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; margin-bottom: 1.25rem; }
.ct-hr__title { margin: 0; font-family: var(--t-display, inherit); font-size: clamp(1.5rem, 2.4vw, 2rem); font-weight: 700; line-height: 1.3; color: var(--t-ink, #1f2328); }
.ct-hr__cta { display: inline-flex; align-items: center; min-height: 44px; padding: 0.5rem 1.1rem; border-radius: 999px; border: 1px solid var(--main-color, #0d7a73); color: var(--main-color, #0d7a73); font-weight: 700; font-size: 0.95rem; text-decoration: none; transition: background 0.2s ease, color 0.2s ease; }
.ct-hr__cta:hover { background: var(--main-color, #0d7a73); color: var(--t-accent-ink, #fff); }
.ct-hr__cta:focus-visible, .ct-hr__card:focus-visible { outline: 3px solid color-mix(in srgb, var(--main-color, #0d7a73) 45%, transparent); outline-offset: 2px; }
.ct-hr__viewport { position: relative; -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent); mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent); }
.ct-hr__track { display: flex; gap: 1rem; width: max-content; margin: 0; padding: 0.25rem 0; list-style: none; }
.ct-hr__track--still { width: auto; flex-wrap: wrap; justify-content: center; }
.ct-hr__viewport--still { -webkit-mask-image: none; mask-image: none; }
.ct-hr__track--moving { animation: ct-hr-ltr var(--ct-hr-duration, 48s) linear infinite; }
[dir="rtl"] .ct-hr__track--moving { animation-name: ct-hr-rtl; }
.ct-hr__viewport:hover .ct-hr__track--moving, .ct-hr__viewport:focus-within .ct-hr__track--moving { animation-play-state: paused; }
@keyframes ct-hr-ltr { from { transform: translateX(0); } to { transform: translateX(calc(-50% - 0.5rem)); } }
@keyframes ct-hr-rtl { from { transform: translateX(0); } to { transform: translateX(calc(50% + 0.5rem)); } }
.ct-hr__card { flex: 0 0 auto; width: min(80vw, 320px); display: flex; flex-direction: column; gap: 0.75rem; padding: 1.1rem 1.2rem; border: 1px solid var(--t-line, #e3e6ea); border-radius: var(--t-radius-lg, 16px); background: var(--t-surface, #ffffff); box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04); }
.ct-hr__stars { display: inline-flex; gap: 1px; font-size: 1.05rem; line-height: 1; color: color-mix(in srgb, var(--t-ink, #1f2328) 18%, transparent); }
.ct-hr__stars .is-on { color: #f59e0b; }
.ct-hr__msg { margin: 0; flex: 1; color: var(--t-ink, #1f2328); line-height: 1.7; overflow-wrap: anywhere; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
.ct-hr__who { display: flex; align-items: center; gap: 0.6rem; }
.ct-hr__avatar { flex: none; display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: color-mix(in srgb, var(--main-color, #0d7a73) 12%, var(--t-surface, #fff)); color: var(--main-color, #0d7a73); font-weight: 800; }
.ct-hr__name { font-weight: 700; font-size: 0.95rem; overflow-wrap: anywhere; }
@media (prefers-reduced-motion: reduce) {
  .ct-hr__track--moving { animation: none; }
  .ct-hr__viewport { overflow-x: auto; scroll-snap-type: x mandatory; -webkit-mask-image: none; mask-image: none; }
  .ct-hr__card { scroll-snap-align: start; }
  .ct-hr__copy { display: none; }
}
`;
---

{strip.show && (
    <section class="ct-hr" aria-labelledby="ct-hr-title" data-ct-reviews lang={lang} dir={t.dir}>
        <style is:inline set:html={css} />
        <div class="ct-hr__wrap">
            <div class="ct-hr__head">
                <h2 id="ct-hr-title" class="ct-hr__title">{t.homeTitle}</h2>
                <a class="ct-hr__cta" href={reviewsHref(lang)}>{t.homeCta}</a>
            </div>
        </div>
        <div class={`ct-hr__viewport${strip.scrolls ? "" : " ct-hr__viewport--still"}`}>
            <ul
                class={`ct-hr__track ${strip.scrolls ? "ct-hr__track--moving" : "ct-hr__track--still"}`}
                style={strip.scrolls ? `--ct-hr-duration: ${strip.durationSeconds}s` : undefined}
            >
                {(strip.scrolls ? [0, 1] : [0]).map((copy) =>
                    strip.half.map((review, i) => {
                        const repeat = copy === 1 || i >= strip.uniqueCount;
                        return (
                        <li class={`ct-hr__card${repeat ? " ct-hr__copy" : ""}`} aria-hidden={repeat ? "true" : undefined}>
                            <span class="ct-hr__stars" role="img" aria-label={t.starsLabel(review.rating)}>
                                {[1, 2, 3, 4, 5].map((n) => (
                                    <span aria-hidden="true" class={n <= review.rating ? "is-on" : undefined}>★</span>
                                ))}
                            </span>
                            <p class="ct-hr__msg" dir="auto">{review.message}</p>
                            <div class="ct-hr__who">
                                <span class="ct-hr__avatar" aria-hidden="true">{initialOf(review.name)}</span>
                                <span class="ct-hr__name" dir="auto">{review.name}</span>
                            </div>
                        </li>
                        );
                    }),
                )}
            </ul>
        </div>
    </section>
)}
