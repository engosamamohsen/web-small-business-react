---
// Home page of the Salon theme (registry.ts → salon, layout.hero "salon"): an editorial, phone-first
// front for beauty salons, barbers and service stores. Server-rendered, no island; the gallery's
// lightbox is a small script on a native <dialog>.
//   hero (banner, gallery photo or a drawn arch) → services (booking on) → gallery → about →
//   home visits → branches → contact.
// With booking off the same sections show without the booking buttons (gallery, about, branches,
// contact); index.astro passes the products (when the store sells any) into the slot before contact.
// Styles: ./salon.css (this page) + src/styles/themes.css / booking.css ([data-theme="salon"]).
import ServicesList from "@/components/Booking/ServicesList.astro";
import { homeAreas } from "@/lib/booking/home";
import { t } from "@/lib/booking/strings";
import { effectivePrice, formatMoney } from "@/lib/booking/totals";
import type { BookingCatalog } from "@/lib/booking/types";
import { isResizable, resizedUrl, storeImageProps } from "@/lib/responsive-image";
import { socialLinks, mapsLink, type GalleryPhoto, type StoreBranch } from "@/lib/showcase";
import { buildWhatsAppLink, resolveWhatsappNumber } from "@/lib/whatsapp-order";
import type { SettingsData } from "@/hooks/fetchSettings";
import "@/styles/booking.css";
import "./salon.css";

interface Props {
    settings: SettingsData | null;
    storeName: string;
    /** Banners (v1/banner): the first one leads the hero. */
    banners: Array<{ image?: string | null; title?: string | null }>;
    gallery: GalleryPhoto[];
    branches: StoreBranch[];
    /** The store takes bookings: booking buttons and the services section. */
    booking: boolean;
    /** null when the services couldn't be loaded (the page still offers the book button). */
    catalog: BookingCatalog | null;
    /** The store sells products (they follow below, in #products). */
    hasProducts: boolean;
}

const { settings, storeName, banners, gallery, branches, booking, catalog, hasProducts } = Astro.props;

const about = settings?.about_us?.replace(/\s+/g, " ").trim() ?? "";
// The hero keeps the first sentence; the whole text is in "عن المكان".
const lead = (() => {
    if (!about) return booking ? t.servicesIntro : "";
    const first = (about.match(/[^.!؟?]+[.!؟?]?/) ?? [about])[0].trim();
    return first.length > 150 ? `${first.slice(0, 148).trimEnd()}…` : first;
})();

const services = catalog?.services ?? [];
const fromPrice = services.length ? Math.min(...services.map((s) => effectivePrice(s))) : null;
const areas = catalog?.settings.home?.offered ? homeAreas(catalog.settings) : [];
const homeOffered = booking && areas.length > 0;

const whatsapp = buildWhatsAppLink(resolveWhatsappNumber(settings));
const social = socialLinks(settings);
const phones = (settings?.phone ?? "").split(/[\s,،/]+/).map((p) => p.trim()).filter((p) => /^\+?\d{6,15}$/.test(p)).slice(0, 2);

// Branches from the API; a store with none listed shows its address from the settings.
const places: StoreBranch[] = branches.length
    ? branches
    : settings?.full_address?.trim()
      ? [{ id: 0, address: settings.full_address.replace(/\s+/g, " ").trim(), whatsappUrl: whatsapp, mapUrl: mapsLink({ address: settings.full_address }) }]
      : [];

// Hero photo: the first banner, else the first gallery photo, else a drawn arch with the initial.
const heroPhoto = banners.find((b) => b?.image)?.image ?? gallery[0]?.url ?? null;
const heroAccent = (banners.filter((b) => b?.image)[1]?.image ?? (heroPhoto === gallery[0]?.url ? gallery[1]?.url : gallery[0]?.url)) ?? null;
const initial = Array.from(storeName.trim())[0] ?? "✦";
const img = (src: string, sizes: string, max: number) => {
    const p = storeImageProps(src, sizes, max);
    return { src: p.src, srcset: p.srcSet, sizes: p.sizes, "data-orig": p["data-orig"] };
};
// Gallery mosaic: the first photo takes 2×2 and the rest fill the rows (2 columns on phones, 4 on
// wide screens); photos at the end stretch over what their row would leave empty.
const rest = gallery.length - 1;
const tileStyle = (i: number): string => {
    const vars = [`--ct-i: ${i % 4}`];
    const last = i === gallery.length - 1 && i > 0;
    if (last && rest % 2 === 1) vars.push("--sl-col: 2");
    if (i > 0) {
        if (rest === 1) vars.push("--sl-col-wide: 2", "--sl-row-wide: 2");
        else if (rest === 2) vars.push("--sl-col-wide: 2");
        else if (last && rest === 3) vars.push("--sl-col-wide: 2");
        else if (last && rest > 4 && (rest - 4) % 4 !== 0) vars.push(`--sl-col-wide: ${5 - ((rest - 4) % 4)}`);
    }
    return vars.join("; ");
};
const full = (src: string) => (isResizable(src) ? resizedUrl(src, 1600) : src);

// About: two photos beside the text (gallery photos the hero doesn't already show).
const aboutPhotos = gallery.filter((g) => g.url !== heroPhoto && g.url !== heroAccent).slice(0, 2);
// Shown only with the store's own words (Settings → about us); the gallery already shows the photos.
// Left out when the hero already shows all of it (a one-sentence about).
const showAbout = Boolean(about) && about !== lead;

const eyebrow = settings?.shop_type === "beauty" || settings?.shop_type === "salon" ? "صالون · عناية وجمال" : settings?.shop_type === "service" ? "خدمات بالحجز" : "أهلاً بيك";

// Buttons: booking first; without booking, the products, WhatsApp or the gallery.
const primary = booking
    ? { href: "/book", label: t.navBook }
    : hasProducts
      ? { href: "#products", label: "تسوّق الآن" }
      : whatsapp
        ? { href: whatsapp, label: "تواصل على واتساب", external: true }
        : gallery.length
          ? { href: "#gallery", label: "شوف شغلنا" }
          : null;
const secondary = booking
    ? { href: "#services", label: t.servicesTitle }
    : gallery.length && primary?.href !== "#gallery"
      ? { href: "#gallery", label: "معرض الصور" }
      : places.length
        ? { href: "#branches", label: "فروعنا" }
        : null;

const facts = [
    booking && services.length ? (services.length === 1 ? "خدمة واحدة" : services.length === 2 ? "خدمتين" : `${services.length} خدمات`) : null,
    booking && fromPrice !== null && fromPrice > 0 ? `تبدأ من ${formatMoney(fromPrice)}` : null,
    homeOffered ? "زيارات منزلية" : null,
    places.length > 1 ? `${places.length} فروع` : null,
].filter(Boolean) as string[];
---

<div class="sl">
    <!-- ── Hero ─────────────────────────────────────────────────────────── -->
    <section class="sl-hero" aria-labelledby="sl-title">
        <div class="sl-wrap sl-hero__grid">
            <div class="sl-hero__copy">
                <p class="sl-eyebrow" data-reveal>{eyebrow}</p>
                <h1 class="sl-hero__title" id="sl-title" data-reveal style="--ct-i: 1">{storeName}</h1>
                {lead && <p class="sl-hero__lead" data-reveal style="--ct-i: 2">{lead}</p>}
                {(primary || secondary) && (
                    <div class="sl-hero__actions" data-reveal style="--ct-i: 3">
                        {primary && (
                            <a class="sl-btn sl-btn--primary" href={primary.href} {...(primary.external ? { target: "_blank", rel: "noopener" } : {})}>
                                <span>{primary.label}</span>
                                <span class="sl-btn__icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="16" height="16"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                </span>
                            </a>
                        )}
                        {secondary && <a class="sl-btn sl-btn--ghost" href={secondary.href}>{secondary.label}</a>}
                    </div>
                )}
                {facts.length > 0 && (
                    <ul class="sl-hero__facts" role="list" data-reveal style="--ct-i: 4">
                        {facts.map((f) => <li>{f}</li>)}
                    </ul>
                )}
            </div>

            <div class="sl-hero__media" data-reveal style="--ct-i: 1">
                <div class="sl-arch">
                    {heroPhoto ? (
                        <img {...img(heroPhoto, "(min-width: 900px) 460px, 78vw", 520)} alt={banners[0]?.title || storeName} fetchpriority="high" decoding="async" width="460" height="600" />
                    ) : (
                        <div class="sl-arch__drawn" aria-hidden="true"><span>{initial}</span></div>
                    )}
                </div>
                {heroAccent && (
                    <div class="sl-hero__accent" aria-hidden="true">
                        <img {...img(heroAccent, "160px", 160)} alt="" loading="lazy" decoding="async" width="160" height="160" />
                    </div>
                )}
                <svg class="sl-hero__ornament" viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="58" fill="none" stroke="currentColor" stroke-width="0.8" stroke-dasharray="2 6" /></svg>
            </div>
        </div>
    </section>

    <!-- ── Services (booking on) ────────────────────────────────────────── -->
    {booking && (
        <section class="sl-section sl-services" id="services" aria-labelledby="sl-services-title">
            <div class="sl-wrap">
                <header class="sl-head" data-reveal>
                    <p class="sl-eyebrow">القائمة والأسعار</p>
                    <h2 class="sl-head__title" id="sl-services-title">{t.servicesTitle}</h2>
                    <p class="sl-head__lead">{t.servicesIntro}</p>
                </header>
                <div class="ct-bk sl-services__list" data-reveal style="--ct-i: 1">
                    {catalog ? (
                        <ServicesList catalog={catalog} headingLevel={3} />
                    ) : (
                        <div class="ct-bk-card ct-bk-empty" role="alert">
                            <p>{t.loadFailed}</p>
                            <a class="ct-bk-btn" href="/services">{t.backToServices}</a>
                        </div>
                    )}
                </div>
            </div>
        </section>
    )}

    <!-- ── Gallery ──────────────────────────────────────────────────────── -->
    {gallery.length > 0 && (
        <section class="sl-section sl-gallery" id="gallery" aria-labelledby="sl-gallery-title">
            <div class="sl-wrap">
                <header class="sl-head" data-reveal>
                    <p class="sl-eyebrow">من شغلنا</p>
                    <h2 class="sl-head__title" id="sl-gallery-title">معرض الصور</h2>
                </header>
                <ul class="sl-gallery__grid" role="list">
                    {gallery.map((photo, i) => (
                        <li class="sl-gallery__item" data-reveal style={tileStyle(i)}>
                            <button type="button" class="sl-gallery__open" data-sl-photo={i} data-full={full(photo.url)} aria-label={`افتح صورة ${i + 1} من ${gallery.length}`}>
                                <img {...img(photo.url, i === 0 ? "(min-width: 900px) 560px, 92vw" : "(min-width: 900px) 280px, 46vw", i === 0 ? 560 : 300)} alt={`${storeName}: صورة ${i + 1}`} loading="lazy" decoding="async" width="400" height="400" />
                            </button>
                        </li>
                    ))}
                </ul>
            </div>

            <dialog class="sl-lightbox" aria-label="معرض الصور">
                <div class="sl-lightbox__frame">
                    <img class="sl-lightbox__img" alt="" />
                    <p class="sl-lightbox__count" aria-live="polite"></p>
                </div>
                <button type="button" class="sl-lightbox__btn sl-lightbox__close" data-sl-close aria-label="إغلاق">
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                </button>
                {gallery.length > 1 && (
                    <>
                        <button type="button" class="sl-lightbox__btn sl-lightbox__prev" data-sl-step="-1" aria-label="الصورة السابقة">
                            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </button>
                        <button type="button" class="sl-lightbox__btn sl-lightbox__next" data-sl-step="1" aria-label="الصورة التالية">
                            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </button>
                    </>
                )}
            </dialog>
        </section>
    )}

    <!-- ── About ────────────────────────────────────────────────────────── -->
    {showAbout && (
        <section class="sl-section sl-about" id="about" aria-labelledby="sl-about-title">
            <div class="sl-wrap sl-about__grid">
                <div class="sl-about__text" data-reveal>
                    <p class="sl-eyebrow">عن المكان</p>
                    <h2 class="sl-head__title" id="sl-about-title">{`عن ${storeName}`}</h2>
                    <p class="sl-about__body">{about}</p>
                    {booking && <a class="sl-link" href="/book">{t.navBook}<span aria-hidden="true"> ←</span></a>}
                </div>
                {aboutPhotos.length > 0 && (
                    <div class={`sl-about__photos sl-about__photos--${aboutPhotos.length}`} data-reveal style="--ct-i: 1">
                        {aboutPhotos.map((p, i) => (
                            <div class="sl-about__photo">
                                <img {...img(p.url, "(min-width: 900px) 260px, 44vw", 280)} alt={`${storeName}: من شغلنا ${i + 1}`} loading="lazy" decoding="async" width="260" height="340" />
                            </div>
                        ))}
                    </div>
                )}
            </div>
        </section>
    )}

    <!-- ── Home visits ──────────────────────────────────────────────────── -->
    {homeOffered && (
        <section class="sl-section sl-home" aria-labelledby="sl-home-title">
            <div class="sl-wrap">
                <div class="sl-home__card" data-reveal>
                    <div>
                        <p class="sl-eyebrow">{t.homeVisit}</p>
                        <h2 class="sl-head__title" id="sl-home-title">بنوصلك لحد البيت</h2>
                        <p class="sl-head__lead">اختار «{t.atHome}» وانت بتحجز، والمحل هيأكد ويبعتلك حد في الميعاد.</p>
                    </div>
                    <ul class="sl-home__areas" role="list">
                        {areas.map((a) => (
                            <li>
                                <span>{a.name}</span>
                                <em>{a.fee > 0 ? formatMoney(a.fee) : t.free}</em>
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </section>
    )}

    <!-- ── Branches ─────────────────────────────────────────────────────── -->
    {places.length > 0 && (
        <section class="sl-section sl-branches" id="branches" aria-labelledby="sl-branches-title">
            <div class="sl-wrap">
                <header class="sl-head" data-reveal>
                    <p class="sl-eyebrow">{places.length > 1 ? "فروعنا" : "مكاننا"}</p>
                    <h2 class="sl-head__title" id="sl-branches-title">{places.length > 1 ? "زورنا في أقرب فرع" : "تعالى زورنا"}</h2>
                </header>
                <ul class="sl-branches__list" role="list">
                    {places.map((b, i) => (
                        <li class="sl-branch" data-reveal style={`--ct-i: ${i % 3}`}>
                            <span class="sl-branch__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                            <p class="sl-branch__address">{b.address}</p>
                            <div class="sl-branch__actions">
                                {b.mapUrl && (
                                    <a class="sl-chip" href={b.mapUrl} target="_blank" rel="noopener" aria-label={`افتح على الخريطة: ${b.address}`}>
                                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0113 0C18.5 15.4 12 21 12 21z" fill="none" stroke="currentColor" stroke-width="1.4" /><circle cx="12" cy="10" r="2.2" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
                                        افتح على الخريطة
                                    </a>
                                )}
                                {b.whatsappUrl && (
                                    <a class="sl-chip sl-chip--wa" href={b.whatsappUrl} target="_blank" rel="noopener" aria-label={`واتساب: ${b.address}`}>
                                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M4 20l1.2-3.8A8 8 0 1112 20a8 8 0 01-4-1.1L4 20z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
                                        واتساب
                                    </a>
                                )}
                            </div>
                        </li>
                    ))}
                </ul>
            </div>
        </section>
    )}

    <!-- The store's products (index.astro), when it sells any -->
    <slot />

    <!-- ── Contact ──────────────────────────────────────────────────────── -->
    <section class="sl-contact" id="contact" aria-labelledby="sl-contact-title">
        <div class="sl-wrap sl-contact__inner" data-reveal>
            <p class="sl-eyebrow sl-eyebrow--light">تواصل معنا</p>
            <h2 class="sl-contact__title" id="sl-contact-title">{booking ? "موعدك الجاي يبدأ من هنا" : "يسعدنا نسمع منك"}</h2>
            <div class="sl-contact__actions">
                {booking && (
                    <a class="sl-btn sl-btn--light" href="/book">
                        <span>{t.navBook}</span>
                        <span class="sl-btn__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="16" height="16"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </span>
                    </a>
                )}
                {whatsapp && <a class="sl-btn sl-btn--outline" href={whatsapp} target="_blank" rel="noopener">واتساب</a>}
                {phones.map((p) => <a class="sl-btn sl-btn--outline" href={`tel:${p}`} dir="ltr">{p}</a>)}
            </div>
            {(social.instagram || social.facebook) && (
                <ul class="sl-contact__social" role="list">
                    {social.instagram && <li><a href={social.instagram} target="_blank" rel="noopener">Instagram</a></li>}
                    {social.facebook && <li><a href={social.facebook} target="_blank" rel="noopener">Facebook</a></li>}
                </ul>
            )}
        </div>
    </section>
</div>

<script>
    // Gallery lightbox: tap a photo to see it large; arrows, swipe and Esc work.
    function setup() {
        const dialog = document.querySelector<HTMLDialogElement>(".sl-lightbox");
        const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-sl-photo]"));
        if (!dialog || !buttons.length || dialog.dataset.ready) return;
        dialog.dataset.ready = "1";
        const image = dialog.querySelector<HTMLImageElement>(".sl-lightbox__img")!;
        const count = dialog.querySelector<HTMLElement>(".sl-lightbox__count")!;
        let index = 0;
        let opener: HTMLButtonElement | null = null;

        const show = (i: number) => {
            index = (i + buttons.length) % buttons.length;
            const button = buttons[index];
            image.src = button.dataset.full ?? "";
            image.alt = button.querySelector("img")?.alt ?? "";
            count.textContent = `${index + 1} / ${buttons.length}`;
        };

        buttons.forEach((button, i) =>
            button.addEventListener("click", () => {
                opener = button;
                show(i);
                if (typeof dialog.showModal === "function") dialog.showModal();
                else window.open(button.dataset.full, "_blank", "noopener");
            }),
        );
        dialog.querySelectorAll<HTMLButtonElement>("[data-sl-step]").forEach((b) =>
            b.addEventListener("click", () => show(index + Number(b.dataset.slStep))),
        );
        dialog.querySelector("[data-sl-close]")?.addEventListener("click", () => dialog.close());
        // A tap on the dark backdrop closes it.
        dialog.addEventListener("click", (e) => {
            if (e.target === dialog) dialog.close();
        });
        dialog.addEventListener("close", () => opener?.focus());
        // RTL: the right arrow goes back, the left arrow forward.
        dialog.addEventListener("keydown", (e) => {
            if (e.key === "ArrowLeft") show(index + 1);
            if (e.key === "ArrowRight") show(index - 1);
        });
        let startX: number | null = null;
        dialog.addEventListener("touchstart", (e) => (startX = e.touches[0]?.clientX ?? null), { passive: true });
        dialog.addEventListener("touchend", (e) => {
            const endX = e.changedTouches[0]?.clientX;
            if (startX === null || endX === undefined || Math.abs(endX - startX) < 40) return;
            show(index + (endX > startX ? 1 : -1));
            startX = null;
        });
    }
    setup();
    document.addEventListener("astro:page-load", setup);
</script>
