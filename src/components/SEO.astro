---
interface Props {
  title: string;
  description: string;
  keywords?: string[];
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  canonical?: string;
  type?: 'website' | 'article' | 'product';
  // Public-facing origin of the CURRENT tenant (e.g. "https://roka.cashierthru.com").
  // Passed down from Layout via getSiteOrigin(). Falls back to Astro.site only
  // when absent. This is what makes canonical/OG URLs point at the tenant's own
  // domain instead of the shared base domain — required for per-subdomain indexing.
  origin?: string;
  // When true, emit `noindex` so the page is kept out of search results
  // (cart, checkout, auth, account, order pages).
  noindex?: boolean;
  // One or more JSON-LD structured-data objects (Product, Organization, …).
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  keywords = [],
  image = '/default-og-image.jpg',
  imageWidth,
  imageHeight,
  canonical,
  type = 'website',
  origin,
  noindex = false,
  jsonLd,
} = Astro.props;

// Prefer the live tenant origin; fall back to the configured site, then "/".
const base = origin || (Astro.site ? Astro.site.toString() : Astro.url.origin);

// Canonical uses the path only (no query string) so filtered views like
// /?category=1 don't fragment indexing — they all canonicalise to the path.
const canonicalURL = canonical || new URL(Astro.url.pathname, base).toString();
// The store's "no image" placeholder (no logo / no product photo yet) never makes a good preview.
const usesDefaultImage = !Astro.props.image || /no_image|placeholder/i.test(Astro.props.image);
const previewImage = usesDefaultImage ? '/default-og-image.jpg' : image;
const fullImageURL = previewImage.startsWith('http') ? previewImage : new URL(previewImage, base).toString();
// Image size: known for the default preview (1200 × 630). For a page's own photo (a product) it's
// unknown, so it's left out rather than claiming a wrong size that makes platforms crop it badly.
const ogWidth = imageWidth ?? (usesDefaultImage ? 1200 : undefined);
const ogHeight = imageHeight ?? (usesDefaultImage ? 630 : undefined);

const robotsContent = noindex ? 'noindex, follow' : 'index, follow';

// Optional Google Search Console meta-tag verification. Only needed if you
// verify via the HTML-tag method; DNS / domain-property verification needs nothing.
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

const structuredData = jsonLd
  ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd])
  : [];
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
<meta name="robots" content={robotsContent} />
<meta name="googlebot" content={robotsContent} />
<link rel="canonical" href={canonicalURL} />

{googleSiteVerification && (
  <meta name="google-site-verification" content={googleSiteVerification} />
)}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageURL} />
{ogWidth && <meta property="og:image:width" content={ogWidth.toString()} />}
{ogHeight && <meta property="og:image:height" content={ogHeight.toString()} />}
<meta property="og:locale" content="ar_EG" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={fullImageURL} />

<!-- Structured data (JSON-LD) -->
{structuredData.map((data) => (
  <script type="application/ld+json" set:html={JSON.stringify(data)} />
))}
