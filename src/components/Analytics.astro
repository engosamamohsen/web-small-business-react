---
// Analytics loaded asynchronously to not block rendering
const GA_MEASUREMENT_ID = import.meta.env.PUBLIC_GA_ID || '';
---

{GA_MEASUREMENT_ID && (
  <>
    <script type="text/partytown" async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    <script type="text/partytown" is:inline define:vars={{ GA_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', GA_MEASUREMENT_ID, {
        page_path: window.location.pathname,
      });
    </script>
  </>
)}
