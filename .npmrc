# React runtime is 19 and @types/react is 19, but @astrojs/react@3 still declares
# a peer range of @types/react ^17||^18. The combination builds and runs fine
# (verified with `astro check`), so we tell npm to tolerate the stale peer range
# instead of failing `npm install` (locally AND on the server during deploy).
#
# Proper long-term fix: upgrade @astrojs/react to v4/v5 (which list @types/react
# ^19 as a peer) and then this flag can be removed.
legacy-peer-deps=true
